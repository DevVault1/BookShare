# ============================
# ADOPT A BOOK - ENV VARIABLES
# ============================

# --- BACKEND (backend/.env) ---
PORT=5000
MONGODB_URI=mongodb://localhost:27017/adopt-a-book
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- WEB (web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# --- MOBILE (mobile/lib/api.ts) ---
# Change API_URL in mobile/lib/api.ts to your local IP
# e.g., http://192.168.1.100:5000/api
